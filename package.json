{
  "name": "apollo-ecommerce-web",
  "version": "1.0.0",
  "private": true,
  "description": "Apollo Engineering (APE Store) Hybrid E-Commerce Ecosystem - Frontend Web Portal",
  "type": "module",
  "scripts": {
    "dev": "next dev --port=3000",
    "build": "next build",
    "start": "next start --port=3000",
    "preview": "next start --port=3000",
    "clean": "rimraf .next dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:trace": "playwright test --trace on",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "audit:lighthouse": "node lighthouse-audit.mjs",
    "test:full-audit": "playwright test --trace on && node lighthouse-audit.mjs",
    "show-trace": "node scripts/open-latest-trace.mjs",
    "show-trace:file": "playwright show-trace",
    "show-report": "playwright show-report",
    "backend": "cd backend && .venv\\Scripts\\python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "exceljs": "npm:exceljs-hardened@^5.0.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.3",
    "react-zoom-pan-pinch": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "jscpd": "^5.3.0",
    "jsdom": "^26.0.0",
    "knip": "^6.37.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "unzipper": "npm:unzipper-esm@^0.13.3",
    "archiver": "^7.0.1"
  }
}
