# Apollo Engineering E-Commerce — Backend Environment Template (.env.example)
# NEVER COMMIT REAL KEYS, SECRETS, OR PASSWORDS TO VERSION CONTROL

ENVIRONMENT=development
DOCS_ENABLED=true
DEBUG=true

# Admin Master Authentication & 2FA (RFC 6238 TOTP)
ADMIN_PASSWORD_HASH=placeholder_argon2_hash
ADMIN_TOTP_SECRET=placeholder_totp_base32_secret

# Database (PostgreSQL 16+)
DATABASE_URL=postgresql+asyncpg://postgres:placeholder_password@localhost:5432/apollo_ecommerce
DATABASE_SYNC_URL=postgresql://postgres:placeholder_password@localhost:5432/apollo_ecommerce

# Authentication (JWT)
JWT_SECRET=placeholder_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Logistics (India Post CEPT)
INDIA_POST_API_URL=https://test.cept.gov.in/beextcustomer
INDIA_POST_USERNAME=placeholder_cept_username
INDIA_POST_PASSWORD=placeholder_cept_password
INDIA_POST_CUSTOMER_ID=placeholder_customer_id
INDIA_POST_CONTRACT_ID=placeholder_contract_id
INDIA_POST_DROPOFF_OFFICE_ID=placeholder_dropoff_id
INDIA_POST_ORIGIN_PINCODE=382430

# OTP & Notifications (MSG91)
MSG91_AUTH_KEY=placeholder_msg91_auth_key
MSG91_TEMPLATE_ID=placeholder_template_id
MSG91_SENDER_ID=APLENG

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
