  "cards": [
    {
      "dot": "cyan",
      "title": "Edge, CDN & Gateway",
      "items": [
        "CloudFront/Cloudflare Edge provides global CDN caching, DDoS shielding, and SSL termination.",
        "Kong Gateway / AWS API Gateway with ALB handles rate limiting, authentication headers, and routing."
      ]
    },
    {
      "dot": "emerald",
      "title": "Core Compute & Data Persistence",
      "items": [
        "Python FastAPI microservices run containerized on AWS EKS with horizontal pod autoscaling.",
        "Aurora PostgreSQL Multi-AZ with PgBouncer connection pooling serves authoritative Decimal state.",
        "Redis Cluster provides sub-millisecond caching for user sessions, catalog, and rate-limit windows."
      ]
    },
    {
      "dot": "amber",
      "title": "Async Workers, Events & Observability",
      "items": [
        "SQS/SNS or Kafka delivers transactional outbox events to asynchronous worker pods.",
        "Amazon S3 securely archives generated statutory PDF invoices and return evidence media.",
        "OpenTelemetry exporter feeds metrics, logs, and distributed traces to Prometheus, Grafana, and Sentry."
      ]
    }
  ]
