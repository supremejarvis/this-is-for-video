# --------------------------------------------------------------------------------------------------
# Apollo Engineering E-Commerce — Frontend Environment Template (.env.example)
# NEVER COMMIT REAL KEYS, SECRETS, OR CREDENTIALS TO VERSION CONTROL
# --------------------------------------------------------------------------------------------------

# Server & Client Environment
NODE_ENV=development
VITE_PORT=3000

# Speed Post Origin Facility Hub (Locked to Kathwada GIDC, Ahmedabad)
VITE_ORIGIN_PINCODE=382430
VITE_ORIGIN_HUB_NAME="APOLLO KATHWADA FACTORY HUB S.O."
VITE_ORIGIN_STATE_CODE=24

# Payment Gateway (Public Key Only on Client; Authoritative Signatures on Backend)
VITE_RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"

# Public SMS / OTP Widget Identifier (Optional)
VITE_MSG91_WIDGET_ID="placeholder_msg91_widget_id"

# Observability & Monitoring (Optional Sandbox Placeholders)
VITE_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
VITE_POSTHOG_KEY="phc_placeholder_key"
VITE_POSTHOG_HOST="https://app.posthog.com"

# Contact Form
VITE_WEB3FORMS_ACCESS_KEY="placeholder_web3forms_key"
